# ==============================================================================
# AnythingLLM - Environment Configuration
# GenAI Training Course - Session 2
# ==============================================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your chosen LLM provider API key
#   3. Uncomment the vector DB section you want to use
#   4. Run: docker compose up -d
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE SETTINGS
# ------------------------------------------------------------------------------
SERVER_PORT=3001
STORAGE_DIR="/app/server/storage"
UID=1000
GID=1000

# JWT Secret - CHANGE THIS to a secure random string (min 32 chars)
JWT_SECRET="change-me-to-a-secure-random-string-min-32-chars"

# Session expiry (optional)
# JWT_EXPIRY="30d"

# Increase timeout for slow local LLMs (default: 5 min, below is 10 min)
ANYTHINGLLM_FETCH_TIMEOUT=600000

# Disable anonymous telemetry (true = opt out)
DISABLE_TELEMETRY="false"

# ==============================================================================
# LLM PROVIDER — Uncomment ONE block
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION A: Ollama (LOCAL - no API key needed, great for demos!)
# Install Ollama on host: https://ollama.ai  then: ollama pull llama3.2
# ------------------------------------------------------------------------------
# LLM_PROVIDER=ollama
# OLLAMA_BASE_PATH=http://host.docker.internal:11434
# OLLAMA_MODEL_PREF=llama3.2
# OLLAMA_MODEL_TOKEN_LIMIT=4096

# ------------------------------------------------------------------------------
# OPTION B: OpenAI
# ------------------------------------------------------------------------------
# LLM_PROVIDER=openai
# OPEN_AI_KEY=sk-proj-your-openai-api-key-here
# OPEN_MODEL_PREF=gpt-4o-mini

# ------------------------------------------------------------------------------
# OPTION C: Google Gemini
# ------------------------------------------------------------------------------
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_LLM_MODEL_PREF=gemini-2.0-flash-lite

# ------------------------------------------------------------------------------
# OPTION D: Anthropic Claude
# ------------------------------------------------------------------------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# ANTHROPIC_MODEL_PREF=claude-sonnet-4-6

# ------------------------------------------------------------------------------
# OPTION E: Groq (Fast cloud inference - free tier available)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_your-groq-api-key-here
# GROQ_MODEL_PREF=llama3-8b-8192

# ------------------------------------------------------------------------------
# OPTION F: OpenRouter (Access 100+ models with one API key)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# OPENROUTER_MODEL_PREF=openrouter/auto

# ------------------------------------------------------------------------------
# OPTION G: LM Studio (LOCAL)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=lmstudio
# LMSTUDIO_BASE_PATH=http://host.docker.internal:1234/v1
# LMSTUDIO_MODEL_PREF=Loaded from Chat UI
# LMSTUDIO_MODEL_TOKEN_LIMIT=4096

# ------------------------------------------------------------------------------
# OPTION H: DeepSeek
# ------------------------------------------------------------------------------
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_MODEL_PREF=deepseek-chat

# ------------------------------------------------------------------------------
# OPTION I: Mistral AI
# ------------------------------------------------------------------------------
# LLM_PROVIDER=mistral
# MISTRAL_API_KEY=your-mistral-api-key-here
# MISTRAL_MODEL_PREF=mistral-small-latest

# ------------------------------------------------------------------------------
# OPTION J: Azure OpenAI
# ------------------------------------------------------------------------------
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_KEY=your-azure-openai-key
# AZURE_OPENAI_MODEL_PREF=your-deployment-name

# ==============================================================================
# EMBEDDING PROVIDER — Uncomment ONE block
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Native (Built-in - DEFAULT, no config needed, zero cost)
# Uses: Xenova/all-MiniLM-L6-v2 running inside the container on CPU
# Perfect for demos and training courses!
# ------------------------------------------------------------------------------
EMBEDDING_ENGINE=native

# ------------------------------------------------------------------------------
# OPTION 2: Ollama Embeddings (if using Ollama for LLM too)
# Run on host: ollama pull nomic-embed-text
# ------------------------------------------------------------------------------
# EMBEDDING_ENGINE=ollama
# EMBEDDING_MODEL_PREF=nomic-embed-text
# OLLAMA_EMBEDDING_BASE_PATH=http://host.docker.internal:11434

# ------------------------------------------------------------------------------
# OPTION 3: OpenAI Embeddings
# ------------------------------------------------------------------------------
# EMBEDDING_ENGINE=openai
# OPEN_AI_KEY=sk-proj-your-openai-api-key-here
# EMBEDDING_MODEL_PREF=text-embedding-3-small

# ------------------------------------------------------------------------------
# OPTION 4: Gemini Embeddings
# ------------------------------------------------------------------------------
# EMBEDDING_ENGINE=gemini
# GEMINI_API_KEY=your-gemini-api-key-here
# EMBEDDING_MODEL_PREF=text-embedding-004

# ==============================================================================
# VECTOR DATABASE — Uncomment ONE block (also update docker-compose.yml!)
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: LanceDB - DEFAULT (built-in, zero config, stored in STORAGE_DIR)
# Best for: demos, training, single-node deployments
# ------------------------------------------------------------------------------
VECTOR_DB=lancedb

# ------------------------------------------------------------------------------
# OPTION 2: ChromaDB (uncomment 'chroma' service in docker-compose.yml)
# Best for: easy self-hosted, good UI via ChromaDB admin
# ------------------------------------------------------------------------------
# VECTOR_DB=chroma
# CHROMA_ENDPOINT=http://chroma:8000
# CHROMA_API_HEADER=X-Api-Key
# CHROMA_API_KEY=changeme

# ------------------------------------------------------------------------------
# OPTION 3: Qdrant (uncomment 'qdrant' service in docker-compose.yml)
# Best for: production, scalable, rich filtering support
# ------------------------------------------------------------------------------
# VECTOR_DB=qdrant
# QDRANT_ENDPOINT=http://qdrant:6333
# QDRANT_API_KEY=                  # leave blank for local unauthenticated

# ------------------------------------------------------------------------------
# OPTION 4: Weaviate (uncomment 'weaviate' service in docker-compose.yml)
# Best for: hybrid search (keyword + vector), large scale
# ------------------------------------------------------------------------------
# VECTOR_DB=weaviate
# WEAVIATE_ENDPOINT=http://weaviate:8080
# WEAVIATE_API_KEY=                # leave blank for local unauthenticated

# ------------------------------------------------------------------------------
# OPTION 5: PGVector / PostgreSQL (uncomment 'postgres' service in compose)
# Best for: teams already using PostgreSQL
# ------------------------------------------------------------------------------
# VECTOR_DB=pgvector
# PGVECTOR_CONNECTION_STRING=postgresql://anythingllm:anythingllm_pass@postgres:5432/anythingllm
# PGVECTOR_USER=anythingllm
# PGVECTOR_PASSWORD=anythingllm_pass
# PGVECTOR_DB=anythingllm

# ------------------------------------------------------------------------------
# OPTION 6: Milvus (uncomment milvus services in docker-compose.yml)
# Best for: enterprise, billions of vectors, distributed
# ------------------------------------------------------------------------------
# VECTOR_DB=milvus
# MILVUS_ADDRESS=http://milvus-standalone:19530
# MILVUS_USERNAME=
# MILVUS_PASSWORD=

# ------------------------------------------------------------------------------
# OPTION 7: Pinecone (Cloud SaaS - no docker service needed)
# ------------------------------------------------------------------------------
# VECTOR_DB=pinecone
# PINECONE_API_KEY=your-pinecone-api-key-here
# PINECONE_INDEX=anythingllm

# ------------------------------------------------------------------------------
# OPTION 8: Zilliz Cloud (Managed Milvus - no docker service needed)
# ------------------------------------------------------------------------------
# VECTOR_DB=zilliz
# ZILLIZ_ENDPOINT=https://your-cluster.zillizcloud.com
# ZILLIZ_API_TOKEN=your-zilliz-api-token-here
